# Maintainer: Mariusz Pacek (sinu0) <https://github.com/sinu0>
#
# Builds Turnpad from the latest commit on GitHub:
#   bash packaging/arch/build.sh    (makepkg -si outside the clone)
# then, as your user: asus-turnpad-setup

pkgname=asus-turnpad-git
_pkgname=asus-turnpad
pkgver=r0
pkgrel=1
pkgdesc="Dial for ASUS DialPads, any touchpad, a mouse or a 3Dconnexion SpaceMouse: radial menu, per-app profiles, on-screen dial for GNOME and layer-shell compositors (based on asus-dialpad-driver)"
arch=('any')
url="https://github.com/sinu0/asus-turnpad"
license=('GPL-2.0-only')
depends=(
    'python'
    'python-libevdev'
    'python-gobject'
    'python-cairo'
    'gtk4'
    'libadwaita'
    'librsvg'
    'libxkbcommon'
    'i2c-tools'
)
optdepends=(
    'gnome-shell: on-screen dial (GNOME Shell 45 or newer)'
    'gtk4-layer-shell: on-screen dial on KDE Plasma 6, Hyprland, sway, niri, COSMIC'
    'python-pywayland: keyboard layout straight from the Wayland compositor'
    'python-systemd: logs in the journal'
    'python-pyusb: screen of a 3Dconnexion SpacePilot Pro'
    'python-xlib: X11 sessions'
    'python-xcffib: X11 sessions'
)
makedepends=('git')
provides=("$_pkgname")
conflicts=("$_pkgname")
install="$_pkgname.install"
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
    cd "$_pkgname"
    # The file list is shared with the .deb and .rpm packages.
    bash packaging/install-files.sh "$pkgdir"
}
